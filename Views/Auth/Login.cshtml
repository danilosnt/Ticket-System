@{
    ViewData["Title"] = "Login";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="logo">
            <i class="fas fa-ticket-alt"></i>
            <h1>Ticket System</h1>
            <p>Faça login para acessar o sistema</p>
        </div>

        <div id="loginError" style="display:none; background:rgba(239,68,68,.12); color:#f87171; padding:12px 16px; border-radius:10px; font-size:13px; margin-bottom:20px; text-align:center;"></div>

        <form id="loginForm" onsubmit="return handleLogin(event)">
            <div class="form-group">
                <label>Usuário</label>
                <div class="input-wrap">
                    <input type="text" id="username" placeholder="Digite seu usuário" required autocomplete="username" />
                    <i class="fas fa-user"></i>
                </div>
            </div>
            <div class="form-group">
                <label>Senha</label>
                <div class="input-wrap">
                    <input type="password" id="password" placeholder="Digite sua senha" required autocomplete="current-password" />
                    <i class="fas fa-lock"></i>
                </div>
            </div>
            <button type="submit" class="btn-glow" id="loginBtn">
                <i class="fas fa-sign-in-alt"></i> Entrar
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // If already logged in, redirect
    $.get('/api/auth/me').done(function(u) {
        window.location.href = '/dashboard';
    });

    function handleLogin(e) {
        e.preventDefault();
        var btn = document.getElementById('loginBtn');
        btn.innerHTML = '<span class="spinner"></span> Entrando...';
        btn.disabled = true;
        $('#loginError').hide();

        $.ajax({
            url: '/api/auth/login',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                username: $('#username').val(),
                password: $('#password').val()
            }),
            success: function(data) {
                if (data.role === 'Admin') {
                    window.location.href = '/admin/panel';
                } else {
                    window.location.href = '/dashboard';
                }
            },
            error: function(xhr) {
                var msg = xhr.responseJSON ? xhr.responseJSON.erro : 'Erro ao fazer login';
                $('#loginError').text(msg).fadeIn();
                btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Entrar';
                btn.disabled = false;
            }
        });
        return false;
    }
</script>
}

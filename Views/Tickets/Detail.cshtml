@{
    ViewData["Title"] = "Detalhe do Chamado";
    var ticketId = ViewData["TicketId"]?.ToString();
}

<div class="dashboard">
    <aside class="sidebar">
        <div class="brand">
            <i class="fas fa-ticket-alt"></i>
            <h2>Ticket System</h2>
        </div>
        <nav>
            <a href="/dashboard"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/dashboard"><i class="fas fa-list"></i> Todos os Chamados</a>
            <a href="#" class="active"><i class="fas fa-eye"></i> Detalhe do Chamado</a>
        </nav>
        <div class="user-info">
            <div class="avatar" id="userAvatar">U</div>
            <div class="details">
                <div class="name" id="userName">Carregando...</div>
                <div class="role" id="userRole">Usuário</div>
            </div>
            <button class="logout-btn" onclick="doLogout()" title="Sair">
                <i class="fas fa-sign-out-alt"></i>
            </button>
        </div>
    </aside>

    <div class="main-content">
        <a href="/dashboard" style="color:var(--text-secondary); text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:6px; margin-bottom:20px; transition:all .2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-secondary)'">
            <i class="fas fa-arrow-left"></i> Voltar ao Dashboard
        </a>

        <div id="ticketHeader" style="margin-bottom:28px;">
            <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                <h1 class="page-title" id="ticketTitle" style="margin-bottom:0;">Carregando...</h1>
                <span id="ticketStatusBadge"></span>
            </div>
            <p class="page-subtitle" style="margin-bottom:0; margin-top:6px;">
                <span style="color:var(--text-muted);">ID:</span>
                <code id="ticketIdDisplay" style="color:var(--accent); font-size:12px;"></code>
            </p>
        </div>

        <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fas fa-building"></i></div>
                <div class="stat-value" id="detailSector" style="font-size:20px;">—</div>
                <div class="stat-label">Setor</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon yellow"><i class="fas fa-flag"></i></div>
                <div id="detailPriority" style="margin-top:4px;"></div>
                <div class="stat-label" style="margin-top:8px;">Prioridade</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-clock"></i></div>
                <div class="stat-value" id="detailTime" style="font-size:20px;">—</div>
                <div class="stat-label">Tempo Total</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red"><i class="fas fa-hourglass-half"></i></div>
                <div class="stat-value" id="detailSla" style="font-size:20px;">—</div>
                <div class="stat-label">SLA Limite</div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
            <div class="table-card" style="padding:24px;">
                <h3 style="font-size:14px; font-weight:700; margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-align-left" style="color:var(--accent);"></i> Descrição
                </h3>
                <p id="detailDescription" style="font-size:13px; color:var(--text-secondary); line-height:1.7; white-space:pre-wrap;">Sem descrição</p>
                <div id="detailImage" style="margin-top:12px;"></div>
            </div>
            <div class="table-card" style="padding:24px;">
                <h3 style="font-size:14px; font-weight:700; margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-lightbulb" style="color:var(--success);"></i> Solução / Motivo de Encerramento
                </h3>
                <p id="detailSolution" style="font-size:13px; color:var(--text-secondary); line-height:1.7; white-space:pre-wrap;">Aguardando resolução...</p>
            </div>
        </div>

        <!-- Timeline -->
        <div class="table-card" style="padding:24px; margin-bottom:24px;">
            <h3 style="font-size:14px; font-weight:700; margin-bottom:20px; display:flex; align-items:center; gap:8px;">
                <i class="fas fa-history" style="color:var(--accent);"></i> Linha do Tempo
            </h3>
            <div id="timeline" style="display:flex; flex-direction:column; gap:0;"></div>
        </div>

        <!-- Discussion -->
        <div class="table-card" style="padding:24px; margin-bottom:24px;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
                <h3 style="font-size:14px; font-weight:700; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-comments" style="color:var(--info);"></i> Discussão
                    <span id="commentCount" style="background:var(--accent-glow); color:var(--accent); padding:2px 8px; border-radius:10px; font-size:11px;">0</span>
                </h3>
            </div>
            <div id="commentsContainer" style="margin-bottom:16px;"></div>
            <div style="display:flex; gap:10px; align-items:flex-start;">
                <div class="avatar" id="commentAvatar" style="width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--success)); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:11px; color:#fff; flex-shrink:0; margin-top:4px;">U</div>
                <div style="flex:1;">
                    <textarea id="commentInput" rows="2" placeholder="Adicionar uma mensagem à discussão..." style="width:100%; padding:10px 14px; background:var(--bg-input); border:1px solid var(--border-color); border-radius:var(--radius); color:var(--text-primary); font-family:inherit; font-size:13px; resize:vertical; outline:none; transition:all .25s;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border-color)'"></textarea>
                    <div style="display:flex; gap:8px; align-items:center; margin-top:8px;">
                        <label style="cursor:pointer; background:var(--bg-input); border:1px solid var(--border-color); padding:6px 12px; border-radius:var(--radius); font-size:12px; color:var(--text-secondary); transition:all .2s; display:flex; align-items:center; gap:5px;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border-color)'">
                            <i class="fas fa-image"></i> Imagem
                            <input type="file" id="commentImageInput" accept="image/*" style="display:none;" />
                        </label>
                        <span id="commentImageName" style="font-size:11px; color:var(--text-muted);"></span>
                        <div style="flex:1;"></div>
                        <button class="btn-glow" style="width:auto; padding:8px 18px; font-size:12px;" onclick="addComment()">
                            <i class="fas fa-paper-plane"></i> Enviar
                        </button>
                    </div>
                    <div id="commentImagePreview" style="margin-top:8px;"></div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div id="actionButtons" style="display:flex; gap:12px;"></div>
    </div>
</div>

<!-- Finish Modal -->
<div class="modal fade" id="finishTicketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-check-circle" style="color:var(--success); margin-right:8px;"></i>Finalizar Chamado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Descrição da Solução</label>
                    <textarea id="solutionInput" rows="4" placeholder="Descreva detalhadamente a solução aplicada..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm" style="background:transparent; color:var(--text-muted); border:1px solid var(--border-color); padding:8px 18px; border-radius:8px;" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-glow btn-success-glow" style="width:auto; padding:10px 24px;" onclick="finishTicket()">
                    <i class="fas fa-check"></i> Finalizar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelTicketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-times-circle" style="color:var(--danger); margin-right:8px;"></i>Encerrar Chamado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Motivo do Encerramento</label>
                    <textarea id="cancelReasonInput" rows="3" placeholder="Ex: Não preciso mais do atendimento..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm" style="background:transparent; color:var(--text-muted); border:1px solid var(--border-color); padding:8px 18px; border-radius:8px;" data-bs-dismiss="modal">Voltar</button>
                <button type="button" style="background:var(--danger); color:#fff; border:none; padding:10px 24px; border-radius:var(--radius); cursor:pointer; font-weight:600; font-size:13px;" onclick="cancelTicketAction()">
                    <i class="fas fa-times"></i> Encerrar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
<script>
    var ticketId = '@Html.Raw(ticketId)';
    var ticket = null;
    var currentUserRole = '';

    // Comment image preview
    $('#commentImageInput').on('change', function() {
        var file = this.files[0];
        if (file) {
            $('#commentImageName').text(file.name);
            var reader = new FileReader();
            reader.onload = function(e) {
                $('#commentImagePreview').html('<img src="' + e.target.result + '" style="max-width:200px; max-height:100px; border-radius:8px; border:1px solid var(--border-color);" />');
            };
            reader.readAsDataURL(file);
        } else {
            $('#commentImageName').text('');
            $('#commentImagePreview').empty();
        }
    });

    $(document).ready(function() {
        checkAuth();
        loadTicket();
        loadComments();
    });

    function checkAuth() {
        $.get('/api/auth/me').done(function(u) {
            currentUserRole = u.role;
            var initials = u.displayName.split(' ').map(function(n){ return n[0]; }).join('').substring(0,2).toUpperCase();
            $('#userAvatar').text(initials);
            $('#commentAvatar').text(initials);
            $('#userName').text(u.displayName);
            var roleLabel = u.role === 'Tecnico' ? 'Técnico' : (u.role === 'Admin' ? 'Administrador' : 'Usuário');
            $('#userRole').text(roleLabel);
        }).fail(function() {
            window.location.href = '/';
        });
    }

    function loadTicket() {
        $.get('/api/tickets/' + ticketId).done(function(data) {
            ticket = data;
            renderDetail();
        }).fail(function() {
            showToast('Chamado não encontrado', 'error');
            setTimeout(function() { window.location.href = '/dashboard'; }, 1500);
        });
    }

    function renderDetail() {
        var t = ticket;
        $('#ticketTitle').text(t.title || 'Sem título');
        $('#ticketIdDisplay').text(t.id);
        $('#ticketStatusBadge').html(getStatusBadge(t.status));
        $('#detailSector').text(t.sector);
        $('#detailPriority').html(getPriorityBadge(t.priority));
        $('#detailTime').text(t.totalTimeHours > 0 ? t.totalTimeHours + 'h' : '—');
        $('#detailSla').text(t.slaLimitHours + 'h');

        if (t.slaBreached) { $('#detailSla').css('color', 'var(--danger)'); $('#detailTime').css('color', 'var(--danger)'); }

        $('#detailDescription').text(t.description || 'Sem descrição informada.');

        // Ticket image
        if (t.imagePath) {
            $('#detailImage').html('<img src="' + t.imagePath + '" style="max-width:100%; max-height:300px; border-radius:8px; border:1px solid var(--border-color); cursor:pointer;" onclick="window.open(this.src)" />');
        }

        if (t.resolutionNotes) {
            var label = t.status === 'Cancelado' ? 'Encerrado por ' + (t.cancelledByName || 'Desconhecido') : 'Finalizado por ' + (t.finishedByName || 'Desconhecido');
            $('#detailSolution').text(t.resolutionNotes + '\n\n— ' + label);
        } else {
            $('#detailSolution').html('<span style="color:var(--text-muted); font-style:italic;">Aguardando resolução...</span>');
        }

        renderTimeline(t);
        renderActions(t);
    }

    function renderTimeline(t) {
        var container = $('#timeline');
        container.empty();
        var events = [];

        events.push({ icon: 'fa-plus-circle', color: 'var(--accent)', title: 'Chamado Criado', subtitle: 'por <strong>' + (t.createdByName || 'Desconhecido') + '</strong>', time: formatDate(t.createdAt) });
        if (t.startedAt) events.push({ icon: 'fa-play-circle', color: 'var(--info)', title: 'Atendimento Iniciado', subtitle: 'por <strong>' + (t.startedByName || 'Desconhecido') + '</strong>', time: formatDate(t.startedAt) });
        if (t.finishedAt && t.status === 'Finalizado') events.push({ icon: 'fa-check-circle', color: 'var(--success)', title: 'Chamado Finalizado', subtitle: 'por <strong>' + (t.finishedByName || 'Desconhecido') + '</strong>', time: formatDate(t.finishedAt) });
        if (t.finishedAt && t.status === 'Cancelado') events.push({ icon: 'fa-times-circle', color: 'var(--danger)', title: 'Chamado Encerrado', subtitle: 'por <strong>' + (t.cancelledByName || 'Desconhecido') + '</strong>', time: formatDate(t.finishedAt) });

        events.forEach(function(ev, i) {
            var isLast = i === events.length - 1;
            container.append(
                '<div style="display:flex; gap:16px; position:relative;">' +
                    '<div style="display:flex; flex-direction:column; align-items:center; min-width:32px;">' +
                        '<div style="width:32px; height:32px; border-radius:50%; background:' + ev.color + '20; display:flex; align-items:center; justify-content:center;">' +
                            '<i class="fas ' + ev.icon + '" style="color:' + ev.color + '; font-size:14px;"></i>' +
                        '</div>' +
                        (isLast ? '' : '<div style="width:2px; flex:1; background:var(--border-color); margin:4px 0;"></div>') +
                    '</div>' +
                    '<div style="padding-bottom:' + (isLast ? '0' : '20px') + ';">' +
                        '<div style="font-size:13px; font-weight:600;">' + ev.title + '</div>' +
                        '<div style="font-size:11px; color:var(--text-muted); margin-top:2px;">' + ev.subtitle + '</div>' +
                        '<div style="font-size:12px; color:var(--text-secondary); margin-top:4px;"><i class="fas fa-calendar-alt" style="margin-right:4px;"></i>' + ev.time + '</div>' +
                    '</div>' +
                '</div>'
            );
        });
    }

    function renderActions(t) {
        var container = $('#actionButtons');
        container.empty();
        var isTecOrAdmin = (currentUserRole === 'Tecnico' || currentUserRole === 'Admin');
        var btns = '';

        if (t.status === 'Aberto') {
            if (isTecOrAdmin) btns += '<button class="btn-glow" style="width:auto; padding:12px 28px;" onclick="startTicket()"><i class="fas fa-play"></i> Iniciar Atendimento</button>';
            btns += '<button style="background:var(--danger); color:#fff; border:none; padding:12px 28px; border-radius:var(--radius); cursor:pointer; font-weight:600; font-size:13px;" onclick="openCancelModal()"><i class="fas fa-times"></i> Encerrar Chamado</button>';
        } else if (t.status === 'EmAndamento') {
            if (isTecOrAdmin) btns += '<button class="btn-glow btn-success-glow" style="width:auto; padding:12px 28px;" onclick="openFinishModal()"><i class="fas fa-check"></i> Finalizar Chamado</button>';
            btns += '<button style="background:var(--danger); color:#fff; border:none; padding:12px 28px; border-radius:var(--radius); cursor:pointer; font-weight:600; font-size:13px;" onclick="openCancelModal()"><i class="fas fa-times"></i> Encerrar Chamado</button>';
        }
        container.html(btns);
    }

    // ── Comments ──
    function loadComments() {
        $.get('/api/tickets/' + ticketId + '/comments').done(function(comments) {
            var container = $('#commentsContainer');
            container.empty();
            $('#commentCount').text(comments.length);

            if (comments.length === 0) {
                container.html('<p style="color:var(--text-muted); font-size:12px; font-style:italic; text-align:center; padding:16px 0;">Nenhuma mensagem ainda. Seja o primeiro a comentar!</p>');
                return;
            }

            comments.forEach(function(c) {
                var initials = c.userName.split(' ').map(function(n){ return n[0]; }).join('').substring(0,2).toUpperCase();
                var imgHtml = c.imagePath ? '<img src="' + c.imagePath + '" style="max-width:300px; max-height:200px; border-radius:8px; border:1px solid var(--border-color); margin-top:8px; cursor:pointer;" onclick="window.open(this.src)" />' : '';
                var contentHtml = c.content ? '<p style="font-size:13px; color:var(--text-secondary); line-height:1.6; margin:0; white-space:pre-wrap;">' + c.content + '</p>' : '';

                container.append(
                    '<div style="display:flex; gap:12px; margin-bottom:16px; padding:14px; background:var(--bg-secondary); border-radius:var(--radius); border:1px solid var(--border-color);">' +
                        '<div style="width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, var(--info), var(--accent)); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:11px; color:#fff; flex-shrink:0;">' + initials + '</div>' +
                        '<div style="flex:1; min-width:0;">' +
                            '<div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">' +
                                '<strong style="font-size:13px;">' + c.userName + '</strong>' +
                                '<span style="font-size:10px; color:var(--text-muted);">' + formatDate(c.createdAt) + '</span>' +
                            '</div>' +
                            contentHtml + imgHtml +
                        '</div>' +
                    '</div>'
                );
            });
        });
    }

    function addComment() {
        var content = $('#commentInput').val();
        var fileInput = document.getElementById('commentImageInput');
        var hasFile = fileInput.files && fileInput.files[0];
        if (!content.trim() && !hasFile) { showToast('Digite uma mensagem ou anexe uma imagem', 'error'); return; }

        var formData = new FormData();
        formData.append('content', content);
        if (hasFile) formData.append('image', fileInput.files[0]);

        $.ajax({
            url: '/api/tickets/' + ticketId + '/comments',
            type: 'POST', data: formData, processData: false, contentType: false,
            success: function() {
                $('#commentInput').val('');
                fileInput.value = '';
                $('#commentImageName').text('');
                $('#commentImagePreview').empty();
                showToast('Mensagem enviada!', 'success');
                loadComments();
            },
            error: function(xhr) { showToast(xhr.responseJSON ? xhr.responseJSON.erro : 'Erro ao enviar', 'error'); }
        });
    }

    function startTicket() {
        $.ajax({ url: '/api/tickets/' + ticketId + '/start', type: 'PUT',
            success: function() { showToast('Atendimento iniciado!', 'info'); loadTicket(); },
            error: function(xhr) { showToast(xhr.responseJSON ? xhr.responseJSON.erro : 'Erro', 'error'); }
        });
    }

    function openFinishModal() { $('#solutionInput').val(''); $('#finishTicketModal').modal('show'); }
    function openCancelModal() { $('#cancelReasonInput').val(''); $('#cancelTicketModal').modal('show'); }

    function finishTicket() {
        var data = { solution: $('#solutionInput').val() };
        if (!data.solution.trim()) { showToast('Informe a solução', 'error'); return; }
        $.ajax({ url: '/api/tickets/' + ticketId + '/finish', type: 'PUT', contentType: 'application/json', data: JSON.stringify(data),
            success: function() { $('#finishTicketModal').modal('hide'); showToast('Chamado finalizado!', 'success'); loadTicket(); },
            error: function(xhr) { showToast(xhr.responseJSON ? xhr.responseJSON.erro : 'Erro', 'error'); }
        });
    }

    function cancelTicketAction() {
        var reason = $('#cancelReasonInput').val();
        if (!reason.trim()) { showToast('Informe o motivo', 'error'); return; }
        $.ajax({ url: '/api/tickets/' + ticketId + '/cancel', type: 'PUT', contentType: 'application/json', data: JSON.stringify({ reason: reason }),
            success: function() { $('#cancelTicketModal').modal('hide'); showToast('Chamado encerrado!', 'success'); loadTicket(); },
            error: function(xhr) { showToast(xhr.responseJSON ? xhr.responseJSON.erro : 'Erro', 'error'); }
        });
    }

    function getStatusBadge(status) {
        var map = { 'Aberto': { cls: 'badge-aberto', label: 'Aberto' }, 'EmAndamento': { cls: 'badge-emandamento', label: 'Em Andamento' }, 'Finalizado': { cls: 'badge-finalizado', label: 'Finalizado' }, 'Cancelado': { cls: 'badge-cancelado', label: 'Cancelado' } };
        var b = map[status] || { cls: 'badge-aberto', label: status };
        return '<span class="badge-status ' + b.cls + '"><span class="dot"></span> ' + b.label + '</span>';
    }

    function getPriorityBadge(priority) {
        var map = { 'Alta': { cls: 'badge-alta', icon: '▲' }, 'Média': { cls: 'badge-media', icon: '●' }, 'Baixa': { cls: 'badge-baixa', icon: '▼' } };
        var b = map[priority] || { cls: 'badge-baixa', icon: '●' };
        return '<span class="badge-priority ' + b.cls + '" style="font-size:14px; padding:6px 14px;">' + b.icon + ' ' + priority + '</span>';
    }

    function formatDate(d) { if (!d) return '—'; return new Date(d).toLocaleString('pt-BR'); }
    function doLogout() { $.post('/api/auth/logout').always(function() { window.location.href = '/'; }); }

    function showToast(msg, type) {
        var icon = type === 'success' ? 'check-circle' : (type === 'error' ? 'exclamation-circle' : 'info-circle');
        var toast = $('<div class="toast-msg ' + type + '"><i class="fas fa-' + icon + '"></i> ' + msg + '</div>');
        $('#toastContainer').append(toast);
        setTimeout(function() { toast.fadeOut(300, function() { $(this).remove(); }); }, 3500);
    }
</script>
}
